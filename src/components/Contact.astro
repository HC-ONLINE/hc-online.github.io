---
import { getEntry } from "astro:content";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const entry = await getEntry("sections", `${lang}/contact`);
if (!entry) throw new Error(`Content not found: sections/${lang}/contact`);
const t = entry.data;

const socialIcons: Record<string, string> = {
  github: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  workana: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M2 4h3.6l2.4 9.2L10.4 4h3.2l2.4 9.2L18.4 4H22l-4.4 16h-3.2L12 10.8 9.6 20H6.4L2 4z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>`,
};
---

<section class="section" id="contact">
  <div class="container mx-auto px-4">
    {/* Section Header */}
    <div class="mb-6">
      <h2 class="section-title text-3xl md:text-4xl font-bold mb-4">
        <span class="section-number">05</span>
        <span class="gradient-text">{t.title}</span>
      </h2>
      <p class="section-subtitle max-w-2xl">{t.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl">
      {/* Contact Form */}
      <div class="glass-card p-4">
        <form
          class="space-y-3"
          id="contact-form"
          action="https://formsubmit.co/bb07a54e2fadf344d84b89fc1c5aa0df"
          method="POST"
          data-sending={t.formSending}
          data-success={t.formSuccess}
          data-error={t.formError}
        >
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input
            type="hidden"
            name="_subject"
            value={`Contact from portfolio (${lang})`}
          />
          <input
            type="text"
            name="_honey"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
          />
          {/* Name */}
          <div>
            <label
              for="name"
              class="block text-sm font-medium text-(--color-text-primary) mb-2"
            >
              {t.formName}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-xl bg-(--color-bg-tertiary) border border-(--color-border) text-(--color-text-primary) placeholder-(--color-text-muted) focus:outline-none focus:border-(--color-border-accent) focus:ring-1 focus:ring-(--color-border-accent) transition-all duration-200"
              placeholder={t.formName}
            />
          </div>

          {/* Email */}
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-(--color-text-primary) mb-2"
            >
              {t.formEmail}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl bg-(--color-bg-tertiary) border border-(--color-border) text-(--color-text-primary) placeholder-(--color-text-muted) focus:outline-none focus:border-(--color-border-accent) focus:ring-1 focus:ring-(--color-border-accent) transition-all duration-200"
              placeholder={t.formEmail}
            />
          </div>

          {/* Message */}
          <div>
            <label
              for="message"
              class="block text-sm font-medium text-(--color-text-primary) mb-2"
            >
              {t.formMessage}
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 rounded-xl bg-(--color-bg-tertiary) border border-(--color-border) text-(--color-text-primary) placeholder-(--color-text-muted) focus:outline-none focus:border-(--color-border-accent) focus:ring-1 focus:ring-(--color-border-accent) transition-all duration-200 resize-none"
              placeholder={t.formMessagePlaceholder ?? t.formMessage}
            ></textarea>
          </div>

          {/* Submit Button */}
          <button
            type="submit"
            id="contact-form-submit"
            class="neon-button w-full justify-center"
          >
            <span>{t.formSubmit}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="relative z-10"
            >
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>

          {/* Status */}
          <p
            id="contact-form-status"
            class="hidden text-sm font-medium"
            role="status"
          >
          </p>
        </form>
      </div>

      {/* Contact Info */}
      <div class="flex flex-col justify-center">
        {/* Email */}
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 rounded-xl bg-[#00f5d4]/10 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-[#00f5d4]"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <div class="text-sm text-(--color-text-muted)">
                {t.infoEmailLabel ?? "Email"}
              </div>
              <div class="flex items-center gap-2">
                <a
                  id="contact-email-link"
                  href="#contact"
                  class="break-all text-lg font-medium text-(--color-text-primary) hover:text-(--color-text-accent) transition-colors"
                >
                  <span id="contact-email-text"></span>
                </a>
                <div class="relative">
                  <button
                    type="button"
                    id="copy-email-btn"
                    class="flex items-center justify-center w-8 h-8 rounded-lg bg-(--color-bg-tertiary) border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-accent) hover:border-(--color-border-accent) transition-all duration-200 cursor-pointer"
                    aria-label={t.copyEmailLabel ?? "Copied!"}
                    title={t.copyEmailLabel ?? "Copied!"}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"
                      ></rect>
                      <path
                        d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                      ></path>
                    </svg>
                  </button>
                  <span
                    id="copy-email-tooltip"
                    role="status"
                    class="absolute left-1/2 -translate-x-1/2 bottom-full mb-2 px-3 py-1 text-xs font-medium whitespace-nowrap rounded-lg bg-[#00f5d4] text-(--color-bg-primary) opacity-0 pointer-events-none transition-opacity duration-200"
                  >
                    {t.copyEmailLabel ?? "Copied!"}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Location */}
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 rounded-xl bg-[#9d4edd]/10 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-[#9d4edd]"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" x2="22" y1="12" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
            </div>
            <div>
              <div class="text-sm text-(--color-text-muted)">
                {t.infoLocationLabel ?? "Location"}
              </div>
              <div class="text-lg font-medium text-(--color-text-primary)">
                {t.contactLocation}
              </div>
            </div>
          </div>
        </div>

        {/* Social Links */}
        <div>
          <div class="text-sm text-(--color-text-muted) mb-4">
            {t.infoConnectLabel ?? "Connect"}
          </div>
          <div class="flex gap-4">
            {
              t.socials.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 rounded-xl bg-(--color-bg-tertiary) border border-(--color-border) flex items-center justify-center text-(--color-text-muted) hover:text-(--color-text-accent) hover:border-(--color-border-accent) hover:bg-(--color-bg-card-hover) transition-all duration-300"
                  aria-label={social.name}
                >
                  <Fragment set:html={socialIcons[social.icon]} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Gradient text */
  .gradient-text {
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: 0;
  }

  /* Glass card */
  .glass-card {
    background: var(--color-surface-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  /* Neon button */
  .neon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-bg-primary);
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    overflow: hidden;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .neon-button:hover {
    box-shadow: 0 0 40px rgba(0, 245, 212, 0.4);
    transform: translateY(-2px);
  }
</style>

<script>
  const copyBtn = document.getElementById(
    "copy-email-btn",
  ) as HTMLButtonElement | null;
  const copyTooltip = document.getElementById(
    "copy-email-tooltip",
  ) as HTMLSpanElement | null;
  const emailLink = document.getElementById(
    "contact-email-link",
  ) as HTMLAnchorElement | null;
  const emailText = document.getElementById(
    "contact-email-text",
  ) as HTMLSpanElement | null;

  const localPart = ["henriquezandres", "856"].join("");
  const domain = ["gmail", "com"].join(".");
  const at = String.fromCharCode(64);
  const email = `${localPart}${at}${domain}`;

  if (emailLink && emailText) {
    emailText.textContent = email;
    emailLink.href = `mailto:${email}`;
  }

  if (copyBtn && copyTooltip) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        copyTooltip.classList.remove("opacity-0");
        copyTooltip.classList.add("opacity-100");
        setTimeout(() => {
          copyTooltip.classList.remove("opacity-100");
          copyTooltip.classList.add("opacity-0");
        }, 2000);
      } catch {
        // clipboard not available
      }
    });
  }

  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const status = document.getElementById(
    "contact-form-status",
  ) as HTMLParagraphElement | null;
  const submitBtn = document.getElementById(
    "contact-form-submit",
  ) as HTMLButtonElement | null;
  const submitText = submitBtn?.querySelector("span");

  if (form && status && submitBtn && submitText) {
    const originalText = submitText.textContent;
    const texts = {
      sending: form.dataset.sending ?? "Sending...",
      success: form.dataset.success ?? "Message sent!",
      error: form.dataset.error ?? "Error sending. Please try again.",
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitText.textContent = texts.sending;
      status.classList.add("hidden");

      const formData = new FormData(form);
      const payload = {
        name: formData.get("name"),
        email: formData.get("email"),
        message: formData.get("message"),
        _subject: formData.get("_subject"),
        _template: formData.get("_template"),
        _captcha: formData.get("_captcha"),
        _honey: formData.get("_honey"),
      };

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          status.textContent = texts.success;
          status.classList.remove("hidden", "text-[#ff6b6b]");
          status.classList.add("text-[#00ff88]");
          form.reset();
        } else {
          throw new Error("FormSubmit error");
        }
      } catch {
        status.textContent = texts.error;
        status.classList.remove("hidden", "text-[#00ff88]");
        status.classList.add("text-[#ff6b6b]");
      } finally {
        submitBtn.disabled = false;
        submitText.textContent = originalText;
      }
    });
  }
</script>
