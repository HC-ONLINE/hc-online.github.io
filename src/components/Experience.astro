---
import { getEntry } from "astro:content";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const entry = await getEntry("sections", `${lang}/experience`);
if (!entry) throw new Error(`Content not found: sections/${lang}/experience`);
const t = entry.data;
---

<section class="section" id="experience">
  <div class="container mx-auto px-4">
    {/* Section Header */}
    <div class="mb-12">
      <h2 class="section-title text-3xl md:text-4xl font-bold mb-4">
        <span class="gradient-text">03</span>
        <span>{t.title}</span>
      </h2>
      <p class="section-subtitle">{t.subtitle}</p>
    </div>

    {/* Experience Timeline - Horizontal Cards */}
    <div class="space-y-6">
      {
        t.experience.map((exp, index) => (
          <div
            class="glass-card p-6 md:p-8 group relative overflow-hidden"
            style={`animation-delay: ${index * 0.15}s`}
          >
            {/* Current Indicator */}
            {exp.current && (
              <div class="absolute top-0 right-0 w-32 h-32 bg-linear-to-br from-[#00f5d4]/10 to-transparent rounded-bl-full" />
            )}

            <div class="flex flex-col md:flex-row md:items-start gap-6">
              {/* Period Badge */}
              <div class="shrink-0">
                <span
                  class={`inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-mono font-medium ${
                    exp.current
                      ? "bg-[#00f5d4]/10 text-[#00f5d4] border border-[#00f5d4]/30"
                      : "bg-(--color-bg-tertiary) text-(--color-text-muted) border border-(--color-border)"
                  }`}
                >
                  {exp.current && (
                    <span class="w-2 h-2 rounded-full bg-[#00f5d4] animate-pulse" />
                  )}
                  {exp.period}
                </span>
              </div>

              {/* Content */}
              <div class="flex-1">
                <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 mb-2">
                  <h3 class="text-xl md:text-2xl font-bold text-(--color-text-primary)">
                    {exp.role}
                  </h3>
                  <span class="text-(--color-text-accent) font-medium">
                    @ {exp.company}
                  </span>
                </div>

                <p class="text-(--color-text-secondary) mb-4 max-w-2xl">
                  {exp.description}
                </p>

                {/* Achievements */}
                <div class="flex flex-wrap gap-3">
                  {exp.achievements.map((achievement) => (
                    <span class="inline-flex items-center gap-2 text-sm text-(--color-text-muted)">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-[#00f5d4]"
                      >
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                      </svg>
                      {achievement}
                    </span>
                  ))}
                </div>
              </div>

              {/* Arrow */}
              <div class="hidden md:flex shrink-0 items-center justify-center w-10 h-10 rounded-full border border-(--color-border) group-hover:border-(--color-border-accent) group-hover:bg-(--color-bg-card-hover) transition-all duration-300">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-(--color-text-muted) group-hover:text-(--color-text-accent) transition-colors"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {/* Education Card */}
    <div class="mt-8">
      <div class="flex items-center gap-4 mb-6">
        <div
          class="w-12 h-12 rounded-xl bg-[#9d4edd]/10 flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-[#9d4edd]"
          >
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-(--color-text-primary)">
          {t.educationTitle}
        </h3>
      </div>

      <div class="space-y-4">
        {t.education.map((edu, index) => (
          <div
            class="glass-card p-6 flex items-start gap-4"
            style={`animation-delay: ${index * 0.1}s`}
          >
            <div class="shrink-0">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-mono font-medium bg-[#9d4edd]/10 text-[#9d4edd] border border-[#9d4edd]/30">
                {edu.year}
              </span>
            </div>
            <div>
              <h4 class="font-semibold text-(--color-text-primary)">
                {edu.degree}
              </h4>
              <p class="text-sm text-(--color-text-muted)">
                {edu.institution}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Section title */
  .section-title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-title::before {
    content: "";
    display: block;
    width: 32px;
    height: 2px;
    background: linear-gradient(135deg, #00f5d4, #00ff88);
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: 3rem;
  }

  /* Gradient text */
  .gradient-text {
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Glass card */
  .glass-card {
    background: var(--color-surface-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glass-card:hover {
    border-color: var(--color-border-accent);
    box-shadow: 0 0 20px rgba(0, 245, 212, 0.1);
  }

  /* Stagger animation */
  .space-y-6 > * {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
  }

  .space-y-6 > *:nth-child(1) {
    animation-delay: 0.1s;
  }
  .space-y-6 > *:nth-child(2) {
    animation-delay: 0.2s;
  }
  .space-y-6 > *:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
