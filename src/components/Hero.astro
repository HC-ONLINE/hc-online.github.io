---
import { getEntry } from "astro:content";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const entry = await getEntry("sections", `${lang}/hero`);
if (!entry) throw new Error(`Content not found: sections/${lang}/hero`);
const t = entry.data;
---

<section
  class="relative min-h-screen flex items-center overflow-hidden pb-28 lg:pb-32"
>
  {/* Background Effects */}
  <div class="absolute inset-0 pointer-events-none">
    {/* Gradient Orbs */}
    <div
      class="absolute top-1/4 left-1/4 w-96 h-96 bg-[#00f5d4] rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-[#9d4edd] rounded-full mix-blend-multiply filter blur-[128px] opacity-15 animate-pulse"
      style="animation-delay: 1s;"
    >
    </div>

    {/* Grid Pattern */}
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(var(--color-text-primary) 1px, transparent 1px), linear-gradient(90deg, var(--color-text-primary) 1px, transparent 1px); background-size: 64px 64px;"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl">
      {/* Eyebrow */}
      <div
        class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full border border-(--color-border-accent) bg-(--color-surface-glass) backdrop-blur-sm animate-fade-in-up"
        style="animation-delay: 0.1s;"
      >
        <span class="w-2 h-2 rounded-full bg-[#00f5d4] animate-pulse"></span>
        <span class="text-sm font-medium text-(--color-text-accent) font-mono"
          >{t.availability}</span
        >
      </div>

      {/* Greeting */}
      <p
        class="text-lg md:text-xl text-(--color-text-muted) mb-4 animate-fade-in-up"
        style="animation-delay: 0.2s;"
      >
        {t.greeting}
      </p>

      {/* Name */}
      <h1
        class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 leading-none animate-fade-in-up"
        style="animation-delay: 0.3s;"
      >
        <span class="gradient-text">{t.name}</span>
      </h1>

      {/* Role */}
      <h2
        class="text-2xl md:text-3xl lg:text-4xl font-semibold text-(--color-text-primary) mb-6 animate-fade-in-up"
        style="animation-delay: 0.4s;"
      >
        {t.role}
      </h2>

      {/* Description */}
      <p
        class="text-lg md:text-xl text-(--color-text-secondary) max-w-2xl mb-10 animate-fade-in-up"
        style="animation-delay: 0.5s;"
      >
        {t.tagline}
      </p>

      {/* CTAs */}
      <div
        class="flex flex-wrap gap-4 mb-16 animate-fade-in-up"
        style="animation-delay: 0.6s;"
      >
        <a href={`/${lang}/projects`} class="neon-button">
          <span>{t.ctaPrimary}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="relative z-10"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a href={`/${lang}#contact`} class="outline-button">
          <span>{t.ctaSecondary}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      </div>

      {/* Stats */}
      <div
        class="grid grid-cols-3 gap-8 pt-8 border-t border-(--color-border) animate-fade-in-up"
        style="animation-delay: 0.7s;"
      >
        {
          t.stats.map((stat) => (
            <div class="text-center md:text-left">
              <div class="text-3xl md:text-4xl font-bold gradient-text mb-1">
                {stat.value}
              </div>
              <div class="text-sm text-(--color-text-muted)">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* Scroll Indicator */}
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 animate-fade-in hidden lg:flex"
    style="animation-delay: 1s;"
  >
    <span class="text-xs text-(--color-text-muted) uppercase tracking-widest"
      >Scroll</span
    >
    <div
      class="w-6 h-10 rounded-full border-2 border-(--color-border) flex justify-center pt-2"
    >
      <div
        class="w-1.5 h-3 rounded-full bg-(--color-text-accent) animate-bounce"
      >
      </div>
    </div>
  </div>
</section>

<style>
  /* Gradient text utility */
  .gradient-text {
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
