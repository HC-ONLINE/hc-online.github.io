---
import { getEntry } from "astro:content";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const entry = await getEntry("sections", `${lang}/featured-projects`);
if (!entry)
  throw new Error(`Content not found: sections/${lang}/featured-projects`);
const t = entry.data;

const projectIcons: Record<string, string> = {
  scan: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" x2="22" y1="2" y2="22"></line></svg>`,
  layout: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><line x1="3" x2="21" y1="9" y2="9"></line><line x1="9" x2="9" y1="21" y2="9"></line></svg>`,
  network: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>`,
};
---

<section class="section" id="projects">
  <div class="container mx-auto px-4">
    {/* Section Header */}
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between mb-12"
    >
      <div>
        <h2 class="section-title text-3xl md:text-4xl font-bold mb-4">
          <span class="section-number">02</span>
          <span class="gradient-text">{t.title}</span>
        </h2>
        <p class="section-subtitle">{t.subtitle}</p>
      </div>
      <a href={`/${lang}/projects`} class="outline-button mt-4 md:mt-0">
        <span>{t.viewAll}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    {/* Projects Grid */}
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children"
    >
      {
        t.projects?.map((project) => (
          <article class="project-card group">
            <div class="project-card-content">
              {/* Header with icon */}
              <div class="flex items-center gap-3 mb-5">
                <div
                  class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300"
                  style={`background: ${project.color}15; color: ${project.color}; border: 1px solid ${project.color}30;`}
                >
                  <Fragment set:html={projectIcons[project.icon]} />
                </div>
                <h3 class="project-card-title mb-0">{project.title}</h3>
              </div>

              {/* Tags */}
              <div class="project-card-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              {/* Description */}
              <p class="project-card-description">{project.description}</p>

              {/* Metrics */}
              <div class="flex gap-4 mb-4">
                {Object.entries(project.metrics).map(([key, value]) => (
                  <div class="flex items-center gap-2">
                    <span class="text-lg font-bold gradient-text">{value}</span>
                    <span class="text-xs text-(--color-text-muted) capitalize">
                      {key}
                    </span>
                  </div>
                ))}
              </div>

              {/* Links */}
              <div class="project-card-links pt-4 border-t border-(--color-border)">
                {project.demo && (
                  <a
                    href={project.demo}
                    class="project-card-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" x2="21" y1="14" y2="3" />
                    </svg>
                    <span>{t.viewDemo}</span>
                  </a>
                )}
                <a
                  href={project.code}
                  class="project-card-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                  <span>{t.viewCode}</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Section title */
  .section-title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-title::before {
    content: "";
    display: block;
    width: 32px;
    height: 2px;
    background: linear-gradient(135deg, #00f5d4, #00ff88);
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: 0;
  }

  /* Gradient text */
  .gradient-text {
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Project Card */
  .project-card {
    position: relative;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover {
    border-color: var(--color-border-accent);
    transform: translateY(-4px);
    box-shadow: 0 4px 24px #00000040;
  }

  .project-card:hover::before {
    transform: scaleX(1);
  }

  .project-card-content {
    padding: 1.5rem;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .project-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .project-card-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .project-card-links {
    display: flex;
    gap: 1.5rem;
  }

  .project-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-accent);
    transition: all 150ms ease;
  }

  .project-card-link:hover {
    color: var(--color-accent-hover);
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--color-text-accent);
    background: rgba(0, 245, 212, 0.1);
    border: 1px solid rgba(0, 245, 212, 0.2);
    transition: all 150ms ease;
  }

  .tag:hover {
    background: rgba(0, 245, 212, 0.2);
    border-color: rgba(0, 245, 212, 0.4);
  }

  /* Stagger animation */
  .stagger-children > * {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
  }

  .stagger-children > *:nth-child(1) {
    animation-delay: 0.1s;
  }
  .stagger-children > *:nth-child(2) {
    animation-delay: 0.2s;
  }
  .stagger-children > *:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
