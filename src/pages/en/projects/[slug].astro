---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ id }) => {
    return id.startsWith("en/");
  });
  return projects.map((project) => {
    const slug = project.id.replace("en/", "").replace(/\.md$/, "");
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const entry = await getEntry("projects", `en/${slug}`);
if (!entry) throw new Error(`Project not found: en/${slug}`);
const { Content } = await entry.render();
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="en"
>
  <article class="prose prose-lg mx-auto">
    <a href="/en/projects" class="text-accent no-underline hover:underline text-sm font-medium mb-8 inline-block">&larr; Back to projects</a>

    <h1>{entry.data.title}</h1>
    <p class="text-muted text-lg">{entry.data.description}</p>

    <div class="flex flex-wrap gap-2 my-4">
      <span class="bg-surface-muted border border-border rounded-full px-3 py-1 text-sm text-muted">{entry.data.stack}</span>
    </div>

    <div class="flex gap-4 my-6">
      {entry.data.github && (
        <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover font-medium">GitHub &rarr;</a>
      )}
      {entry.data.site && (
        <a href={entry.data.site} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover font-medium">Website &rarr;</a>
      )}
    </div>

    <hr />

    <Content />
  </article>
</BaseLayout>
