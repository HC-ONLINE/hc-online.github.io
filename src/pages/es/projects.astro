---
import { getEntry, getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

const entry = await getEntry("pages", "es/projects");
if (!entry) throw new Error("Content not found: es/projects");
const { Content } = await entry.render();

const projects = await getCollection("projects", ({ id }) => {
  return id.startsWith("es/");
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="es"
>
  <article class="prose prose-lg mx-auto">
    <Content />
  </article>

  <div class="grid gap-6 mt-8 max-w-4xl mx-auto px-4">
    {projects.map((project) => (
      <a
        href={`/es/projects/${project.id.replace("es/", "").replace(/\.md$/, "")}`}
        class="block border border-border rounded-lg p-6 bg-surface hover:bg-surface-muted transition-colors duration-200 no-underline"
      >
        <h3 class="text-primary text-xl font-bold mt-0 mb-2">{project.data.title}</h3>
        <p class="text-muted text-sm mb-3">{project.data.subtitle}</p>
        <div class="flex flex-wrap gap-2 mb-3">
          {project.data.stack.split(", ").map((tech) => (
            <span class="bg-surface-muted border border-border rounded-full px-2 py-0.5 text-xs text-muted">{tech}</span>
          ))}
        </div>
        <span class="text-accent text-sm font-medium hover:text-accent-hover">Ver proyecto &rarr;</span>
      </a>
    ))}
  </div>
</BaseLayout>
