---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ id }) => {
    return id.startsWith("es/");
  });
  return projects.map((project) => {
    const slug = project.id.replace("es/", "").replace(/\.md$/, "");
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const entry = await getEntry("projects", `es/${slug}`);
if (!entry) throw new Error(`Project not found: es/${slug}`);
const { Content } = await entry.render();

const meta: Record<string, { icon: string; color: string; label: string }> = {
  "access-manager": { icon: "shield", color: "#00f5d4", label: "IAM" },
  ciberwebscan: { icon: "scan", color: "#00f5d4", label: "Security" },
  demofactory: { icon: "layout", color: "#00ff88", label: "UI/UX" },
  lexguard: { icon: "shield", color: "#9d4edd", label: "Security" },
  lyricflow: { icon: "music", color: "#00ff88", label: "Web App" },
  modelrouter: { icon: "network", color: "#9d4edd", label: "Backend" },
  "orbit-ui": { icon: "layout", color: "#00f5d4", label: "UI/UX" },
  "permission-manager": { icon: "shield", color: "#00ff88", label: "IAM" },
  pixelpress: { icon: "layout", color: "#9d4edd", label: "Web App" },
  typocraft: { icon: "code", color: "#00f5d4", label: "Web App" },
};

const icons: Record<string, string> = {
  shield: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>`,
  scan: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" x2="22" y1="2" y2="22"></line></svg>`,
  layout: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><line x1="3" x2="21" y1="9" y2="9"></line><line x1="9" x2="9" y1="21" y2="9"></line></svg>`,
  network: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>`,
  music: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>`,
  code: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`,
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang="es"
>
  <section class="section">
    <div class="container mx-auto px-4">
      {/* Back Link */}
      <a
        href="/es/projects"
        class="inline-flex items-center gap-2 text-sm text-(--color-text-muted) hover:text-(--color-text-accent) transition-colors mb-10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Volver a proyectos
      </a>

      {/* Project Hero */}
      <div class="max-w-4xl mb-14">
        {/* Icon + category */}
        <div class="flex items-center gap-3 mb-6 animate-fade-in-up">
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center"
            style={`background: ${meta.icon ? "" : ""}${meta[slug]?.color ?? "#00f5d4"}15; color: ${meta[slug]?.color ?? "#00f5d4"}; border: 1px solid ${meta[slug]?.color ?? "#00f5d4"}30;`}
          >
            <Fragment set:html={icons[meta[slug]?.icon ?? "code"] ?? icons.code} />
          </div>
          <span
            class="font-mono text-xs uppercase tracking-widest px-3 py-1 rounded-full"
            style={`background: ${meta[slug]?.color ?? "#00f5d4"}15; color: ${meta[slug]?.color ?? "#00f5d4"}; border: 1px solid ${meta[slug]?.color ?? "#00f5d4"}30;`}
          >
            {meta[slug]?.label ?? "Proyecto"}
          </span>
        </div>

        {/* Title */}
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 leading-tight animate-fade-in-up"
          style="animation-delay: 0.1s"
        >
          <span class="gradient-text">{entry.data.title}</span>
        </h1>

        {/* Subtitle */}
        {entry.data.subtitle && (
          <p
            class="project-subtitle text-xl md:text-2xl font-semibold mb-4 animate-fade-in-up"
            style="animation-delay: 0.15s"
          >
            {entry.data.subtitle}
          </p>
        )}

        {/* Description */}
        <p
          class="text-lg md:text-xl text-(--color-text-secondary) mb-8 animate-fade-in-up"
          style="animation-delay: 0.2s"
        >
          {entry.data.description}
        </p>

        {/* Stack */}
        <div class="flex flex-wrap gap-2 mb-10 animate-fade-in-up" style="animation-delay: 0.3s">
          {entry.data.stack.split(", ").map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>

        {/* Actions */}
        <div class="flex flex-wrap gap-4 animate-fade-in-up" style="animation-delay: 0.4s">
          {entry.data.site && (
            <a href={entry.data.site} target="_blank" rel="noopener noreferrer" class="neon-button">
              <span>Ver sitio</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative z-10">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" x2="21" y1="14" y2="3"></line>
              </svg>
            </a>
          )}
          {entry.data.github && (
            <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class="outline-button">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative z-10">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              <span>Código</span>
            </a>
          )}
        </div>
      </div>

      {/* Content */}
      <div>
        <div class="glass-card p-8 md:p-12">
          <div class="content-styles">
            <Content />
          </div>
        </div>
      </div>

      {/* Next Project */}
      <div class="mt-16 flex justify-between items-center gap-4 flex-wrap">
        <a href="/es/projects" class="outline-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          <span>Todos los proyectos</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Gradient text */
  .gradient-text {
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Project subtitle */
  .project-subtitle {
    color: var(--color-text-accent);
  }

  /* Glass card */
  .glass-card {
    background: var(--color-surface-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  /* Tag */
  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-accent);
    background: var(--color-accent-cyan-dim);
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    transition: all var(--transition-fast);
  }

  .tag:hover {
    background: var(--color-accent-cyan);
    color: var(--color-bg-primary);
  }

  /* Buttons */
  .neon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-bg-primary);
    background: linear-gradient(135deg, #3b82f6, #60a5fa);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    overflow: hidden;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .neon-button::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #00ff88, #00f5d4);
    opacity: 0;
    transition: opacity 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .neon-button:hover {
    box-shadow: 0 0 40px #3b82f650;
    transform: translateY(-2px);
  }

  .neon-button:hover::before {
    opacity: 1;
  }

  .outline-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .outline-button:hover {
    border-color: #00f5d4;
    color: #00f5d4;
    box-shadow: 0 0 20px rgba(0, 245, 212, 0.1);
  }

  /* Content styles (rendered MD) */
  .content-styles :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 2rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .content-styles :global(h2::before) {
    content: "";
    display: block;
    width: 24px;
    height: 2px;
    background: linear-gradient(135deg, #00f5d4, #00ff88);
    flex-shrink: 0;
  }

  .content-styles :global(h2:first-child) {
    margin-top: 0;
  }

  .content-styles :global(p) {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .content-styles :global(ul) {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .content-styles :global(ul) {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2.5rem;
    }
  }

  .content-styles :global(li) {
    position: relative;
    padding-left: 1.75rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .content-styles :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: linear-gradient(135deg, #00f5d4, #00ff88);
  }

  .content-styles :global(li strong) {
    color: var(--color-text-primary);
  }

  .content-styles :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .content-styles :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    margin: 1.5rem 0 2rem;
    font-size: 0.9375rem;
  }

  .content-styles :global(th),
  .content-styles :global(td) {
    padding: 0.875rem 1.25rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--color-border);
  }

  .content-styles :global(th) {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    font-weight: 700;
    white-space: nowrap;
  }

  .content-styles :global(td) {
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .content-styles :global(tr:last-child th),
  .content-styles :global(tr:last-child td) {
    border-bottom: none;
  }

  .content-styles :global(tbody tr:hover) {
    background: var(--color-bg-card-hover);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>
